generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Merchant {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  razorpayKeyId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customers      Customer[]
  payments       Payment[]
  recoveryCases  RecoveryCase[]

  @@map("merchants")
}

model Customer {
  id                     String   @id @default(cuid())
  merchantId             String
  merchant               Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  name                   String
  email                  String
  phone                  String?
  segment                String   @default("new") // new | returning | high_value | at_risk
  lifetimeValue          Int      @default(0) // in paise
  totalTransactions      Int      @default(0)
  successfulTransactions Int      @default(0)
  previousFailures       Int      @default(0)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  payments               Payment[]

  @@index([merchantId])
  @@index([email])
  @@index([segment])
  @@map("customers")
}

model Payment {
  id                String   @id @default(cuid())
  merchantId        String
  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  razorpayPaymentId String?  @unique
  razorpayOrderId   String?
  amount            Int // in paise
  currency          String   @default("INR")
  paymentMethod     String   // upi | card | netbanking | wallet
  status            String   // created | authorized | captured | failed | recovered | pending
  failureReason     String?  // insufficient_funds | bank_timeout | card_declined | expired_card | upi_failure

  failedAt          DateTime?
  recoveredAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attempts          PaymentAttempt[]
  failureEvents     FailureEvent[]
  recoveryCase      RecoveryCase?

  @@index([merchantId, status])
  @@index([customerId])
  @@index([status])
  @@index([paymentMethod])
  @@index([failureReason])
  @@index([createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  attemptNo Int
  status    String
  errorCode String?
  gatewayResponse Json?

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("payment_attempts")
}

model FailureEvent {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  code            String
  reason          String
  gatewayResponse Json?

  createdAt       DateTime @default(now())

  @@index([paymentId])
  @@map("failure_events")
}

model RecoveryCase {
  id                  String   @id @default(cuid())
  paymentId           String   @unique
  payment             Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  merchantId          String
  merchant            Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  status              String   @default("open") // open | in_progress | recovered | failed | escalated
  recoveryProbability Float?
  amountRecovered     Int      @default(0)
  lastAction          String?
  attemptCount        Int      @default(0)
  maxAttempts         Int      @default(3)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  decisions           AgentDecision[]
  actions             RecoveryAction[]

  @@index([merchantId, status])
  @@index([status])
  @@map("recovery_cases")
}

model AgentDecision {
  id                  String   @id @default(cuid())
  recoveryCaseId      String
  recoveryCase        RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  model               String
  inputContext        Json
  decision            String   // the chosen action string
  confidence          Float
  reasoning           String   @db.Text
  recoveryProbability Float
  fallbackAction      String?
  maxAttempts         Int      @default(2)

  policyVerdict       String   // allowed | overridden
  policyReason        String?  @db.Text
  executedAction      String

  createdAt           DateTime @default(now())

  @@index([recoveryCaseId])
  @@map("agent_decisions")
}

model RecoveryAction {
  id              String   @id @default(cuid())
  recoveryCaseId  String
  recoveryCase    RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  type            String   // diagnose | get_history | calculate_probability | ai_decision | policy_validation | retry_payment | create_payment_link | send_message | escalate | record
  status          String   // pending | success | failed | skipped
  input           Json?
  output          Json?
  isSimulated     Boolean  @default(true)

  createdAt       DateTime @default(now())

  @@index([recoveryCaseId])
  @@index([type])
  @@map("recovery_actions")
}

model Notification {
  id              String   @id @default(cuid())
  recoveryCaseId  String
  channel         String   // in_app | email_mock | sms_mock | whatsapp_mock
  recipient       String
  template        String
  payload         Json?
  status          String   @default("pending") // pending | sent | failed
  sentAt          DateTime?

  createdAt       DateTime @default(now())

  @@index([recoveryCaseId])
  @@map("notifications")
}

model WebhookEvent {
  id                String    @id @default(cuid())
  razorpayEventId   String    @unique
  event             String
  payload           Json
  signatureValid    Boolean
  processed         Boolean   @default(false)
  processedAt       DateTime?
  error             String?   @db.Text

  createdAt         DateTime  @default(now())

  @@index([event])
  @@index([processed])
  @@map("webhook_events")
}
