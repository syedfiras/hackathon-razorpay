# Database — Supabase PostgreSQL (free tier)
# Get from Supabase project: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# AI — OpenRouter (free models)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"
# Alternative free models:
# OPENROUTER_MODEL="google/gemini-flash-1.5-8b:free"
# OPENROUTER_MODEL="mistralai/mistral-7b-instruct:free"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay — Test Mode (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: Inngest (local dev uses inngest dev server, no key needed)
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
